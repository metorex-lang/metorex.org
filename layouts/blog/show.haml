%article.page.container
  %nav.doc-crumbs{'aria-label' => 'Breadcrumb'}
    %a{href: '/blog'} Blog
  %h1= title
  - if show-dates
    %p.post-meta= format-date(date, "%B %e, %Y")
  != body
  - if has-tags
    %p.post-tags
      - for tags -> $tag
        %a.post-tag{href: "#{$tag<url>}"}= $tag<name>
  != post-nav-html
