%header.site-header
  .container
    %a.brand{href: '/', 'aria-label' => 'Metorex home'}
      %img.brand-mark.brand-mark-light{src: '/assets/images/logo-light.svg', alt: ''}
      %img.brand-mark.brand-mark-dark{src: '/assets/images/logo-dark.svg', alt: ''}
      %span.wordmark Metorex
    %button.nav-toggle{type: 'button', 'aria-label' => 'Show menu', 'aria-expanded' => 'false', 'aria-controls' => 'site-nav'}
      %span.icon.icon-menu{'aria-hidden' => 'true'}
    %nav.site-nav{id: 'site-nav', 'aria-label' => 'Primary'}
      %a{href: '/install'} Install
      .nav-menu
        %button.nav-menu-toggle{type: 'button', 'aria-expanded' => 'false', 'aria-controls' => 'nav-menu-language'} Language
        %ul.nav-submenu{id: 'nav-menu-language'}
          %li
            %a{href: '/language'} Tour
          %li
            %a{href: '/docs/meta'} Code as Objects
          %li
            %a{href: '/docs/beyond-ruby'} Beyond Ruby
          %li
            %a{href: '/docs/ruby-differences'} MRI Differences
          %li
            %a{href: '/docs/rex'} Rex
      .nav-menu
        %button.nav-menu-toggle{type: 'button', 'aria-expanded' => 'false', 'aria-controls' => 'nav-menu-reference'} Reference
        %ul.nav-submenu{id: 'nav-menu-reference'}
          %li
            %a{href: '/docs'} Docs
          %li
            %a{href: '/docs/cli'} Command Line
          %li
            %a{href: '/docs/stdlib'} Standard Library
          %li
            %a{href: '/docs/c-extensions'} C Extensions
          %li
            %a{href: '/versions'} Versions
      .nav-menu
        %button.nav-menu-toggle{type: 'button', 'aria-expanded' => 'false', 'aria-controls' => 'nav-menu-project'} Project
        %ul.nav-submenu{id: 'nav-menu-project'}
          %li
            %a{href: '/architecture'} Architecture
          %li
            %a{href: '/implementations'} Compare
          %li
            %a{href: '/benchmarks'} Benchmarks
          %li
            %a{href: '/contributing'} Contributing
          %li
            %a{href: 'https://github.com/metorex-lang/metorex', target: '_blank', rel: 'noopener'} GitHub
      %a{href: '/blog'} Blog
      .site-search{'data-blogin-search' => True}
        %input{type: 'search', placeholder: 'Search', autocomplete: 'off', 'aria-label' => 'Search this site'}
        %ul.site-search-results{'data-blogin-results' => True}
    %button.theme-toggle{type: 'button', 'aria-label' => 'Switch between light and dark mode'}
      %span.icon.icon-moon{'aria-hidden' => 'true'}
      %span.icon.icon-sun{'aria-hidden' => 'true'}
